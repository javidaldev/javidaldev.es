RewriteEngine On

# Alias de marketing: web.javidaldev.es → /diseno-web/
# El subdominio no sirve contenido propio; cualquier petición redirige a la URL canónica.
RewriteCond %{HTTP_HOST} ^web\.javidaldev\.es$ [NC]
RewriteRule ^ https://javidaldev.es/diseno-web/ [R=301,L]

# Forzar Redirección HTTPS
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Proteger ficheros de configuración
<Files "config.php">
    Require all denied
</Files>

# Redirecciones Externas
RewriteRule ^github/?$ https://github.com/javidaldev [R=302,L]
RewriteRule ^linkedin/?$ https://www.linkedin.com/in/javidaldev [R=302,L]

# /diseno-web y /diseno-web/ sirven el mismo contenido; el canonical del <head> declara la preferida
RewriteRule ^diseno-web/?$ diseno-web/index.php [L]

# Rutas internas
RewriteRule ^cv/?$ assets/docs/cv-javier-vidal.pdf [L]